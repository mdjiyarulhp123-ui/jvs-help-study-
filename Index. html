<script>
"use strict";

const $ = id => document.getElementById(id);

const classInfo = [
  {n:6, icon:"🌱", desc:"अपनी बुनियादी पढ़ाई मजबूत करो।"},
  {n:7, icon:"📘", desc:"नए विषय सीखो और अभ्यास करो।"},
  {n:8, icon:"🚀", desc:"अगली कक्षा की तैयारी करो।"},
  {n:9, icon:"🎯", desc:"स्कूल टेस्ट और परीक्षा की तैयारी।"},
  {n:10,icon:"🏆", desc:"बोर्ड परीक्षा की तैयारी में मदद।"}
];

function load(key, fallback){
  try{
    const value = JSON.parse(localStorage.getItem(key));
    return value === null ? fallback : value;
  }catch(e){return fallback}
}
function save(key, value){
  try{
    localStorage.setItem(key, JSON.stringify(value));
    return true;
  }catch(e){
    alert("ब्राउज़र में जगह नहीं है या सेविंग बंद है।");
    return false;
  }
}
function escapeHTML(value){
  return String(value).replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[c]);
}

function renderClasses(){
  const q = $("classSearch").value.toLowerCase().trim();
  const list = classInfo.filter(c =>
    ("class "+c.n+" "+c.desc).toLowerCase().includes(q)
  );
  $("classGrid").innerHTML = list.length ? list.map(c => `
    <article class="card class-card">
      <div class="class-icon">${c.icon}</div>
      <span class="tag">CLASS ${c.n}</span>
      <h3>Class ${c.n}</h3>
      <p>${c.desc}</p>
      <button class="btn btn-primary chooseClass" data-class="${c.n}">
        Explore Class →
      </button>
    </article>
  `).join("") : '<div class="empty">कोई कक्षा नहीं मिली।</div>';
}
$("classSearch").addEventListener("input", renderClasses);

$("classGrid").addEventListener("click", e => {
  const btn = e.target.closest(".chooseClass");
  if(!btn) return;
  $("quizClass").value = btn.dataset.class;
  $("noteClass").value = btn.dataset.class;
  $("addClass").value = btn.dataset.class;
  renderNotes();
  $("quizArea").innerHTML =
    '<p class="sub">Class '+btn.dataset.class+' के लिए विषय चुनकर टेस्ट शुरू करो।</p>'+
    '<button class="btn btn-primary" id="startQuiz">Start Quiz →</button>';
  document.querySelector("#quiz").scrollIntoView({behavior:"smooth"});
});

// Practice questions. Add more curriculum-verified questions as needed.
const questions = {
  math: [
    {q:"12 × 8 का मान क्या है?",o:["84","96","108","88"],a:1},
    {q:"त्रिभुज के तीनों कोणों का योग कितना होता है?",o:["90°","180°","270°","360°"],a:1},
    {q:"√81 का मान क्या है?",o:["7","8","9","10"],a:2},
    {q:"यदि x + 5 = 12, तो x कितना है?",o:["5","6","7","8"],a:2},
    {q:"सबसे छोटी अभाज्य संख्या कौन-सी है?",o:["1","2","3","0"],a:1}
  ],
  science: [
    {q:"पौधे अपना भोजन मुख्य रूप से किस प्रक्रिया से बनाते हैं?",o:["श्वसन","प्रकाश संश्लेषण","पाचन","वाष्पीकरण"],a:1},
    {q:"पानी का रासायनिक सूत्र क्या है?",o:["CO₂","O₂","H₂O","NaCl"],a:2},
    {q:"बल की SI इकाई क्या है?",o:["जूल","वाट","न्यूटन","मीटर"],a:2},
    {q:"मनुष्य साँस लेने में मुख्य रूप से कौन-सी गैस उपयोग करता है?",o:["ऑक्सीजन","हाइड्रोजन","हीलियम","नियॉन"],a:0},
    {q:"पृथ्वी के प्राकृतिक उपग्रह का नाम क्या है?",o:["मंगल","चंद्रमा","शुक्र","सूर्य"],a:1}
  ],
  gk: [
    {q:"भारत की राजधानी क्या है?",o:["पटना","मुंबई","नई दिल्ली","कोलकाता"],a:2},
    {q:"भारत का राष्ट्रीय पशु कौन है?",o:["शेर","बाघ","हाथी","मोर"],a:1},
    {q:"एक सप्ताह में कितने दिन होते हैं?",o:["5","6","7","8"],a:2},
    {q:"भारत का स्वतंत्रता दिवस कब मनाया जाता है?",o:["26 जनवरी","15 अगस्त","2 अक्टूबर","14 नवंबर"],a:1},
    {q:"सौरमंडल का तारा कौन है?",o:["पृथ्वी","चंद्रमा","सूर्य","मंगल"],a:2}
  ]
};

const subjectNames = {
  math:"Mathematics", science:"Science", gk:"General Knowledge"
};
let currentQuestions = [];
let currentIndex = 0;
let correctCount = 0;
let chosenAnswer = null;
let quizActive = false;
let quizFinished = false;

$("startQuiz").addEventListener("click", startQuiz);
$("quizClass").addEventListener("change", resetQuizView);
$("quizSubject").addEventListener("change", resetQuizView);

function resetQuizView(){
  quizActive = false;
  quizFinished = false;
  $("quizArea").innerHTML =
    '<p class="sub">टेस्ट शुरू करने के लिए बटन दबाएँ।</p>'+
    '<button class="btn btn-primary" id="startQuiz">Start Quiz →</button>';
  $("startQuiz").addEventListener("click", startQuiz);
}

function startQuiz(){
  const subject = $("quizSubject").value;
  currentQuestions = questions[subject].map(q => ({
    ...q, o:q.o.slice()
  }));
  currentIndex = 0;
  correctCount = 0;
  chosenAnswer = null;
  quizActive = true;
  quizFinished = false;
  showQuestion();
}

function showQuestion(){
  if(currentIndex >= currentQuestions.length){
    finishQuiz();
    return;
  }
  const q = currentQuestions[currentIndex];
  chosenAnswer = null;
  $("quizArea").innerHTML = `
    <div class="tools">
      <span class="tag">CLASS ${$("quizClass").value}</span>
      <span class="tag">${escapeHTML(subjectNames[$("quizSubject").value])}</span>
      <span class="tag">Question ${currentIndex+1}/${currentQuestions.length}</span>
    </div>
    <div style="height:6px;background:var(--border);border-radius:8px">
      <div style="height:6px;width:${currentIndex/currentQuestions.length*100}%;
        background:var(--primary);border-radius:8px"></div>
    </div>
    <div class="quiz-question">${escapeHTML(q.q)}</div>
    <div id="options">
      ${q.o.map((option,i)=>`
        <label class="option">
          <input type="radio" name="answer" value="${i}">
          <span>${escapeHTML(option)}</span>
        </label>
      `).join("")}
    </div>
    <p class="small" id="questionFeedback" aria-live="polite"></p>
    <button class="btn btn-primary" id="submitAnswer">Check Answer</button>
  `;
  $("submitAnswer").addEventListener("click", checkAnswer);
}

function checkAnswer(){
  if(!quizActive || quizFinished) return;
  const selected = document.querySelector('input[name="answer"]:checked');
  if(!selected){
    $("questionFeedback").textContent = "पहले एक विकल्प चुनो।";
    return;
  }
  chosenAnswer = Number(selected.value);
  const q = currentQuestions[currentIndex];
  const isCorrect = chosenAnswer === q.a;
  if(isCorrect) correctCount++;
  quizActive = false;
  document.querySelectorAll('input[name="answer"]').forEach(el=>{
    el.disabled = true;
  });
  $("questionFeedback").innerHTML =
    '<span style="color:'+(isCorrect?'var(--green)':'#d54b53')+'">'+
    (isCorrect ? "✅ सही जवाब!" : "❌ सही जवाब: "+escapeHTML(q.o[q.a]))+
    '</span>';
  $("submitAnswer").textContent =
    currentIndex === currentQuestions.length-1 ? "See Result →" : "Next Question →";
  $("submitAnswer").addEventListener("click", nextQuestion, {once:true});
}

function nextQuestion(){
  currentIndex++;
  quizActive = true;
  showQuestion();
}

function finishQuiz(){
  quizActive = false;
  quizFinished = true;
  const total = currentQuestions.length;
  const percent = Math.round(correctCount/total*100);
  const record = {
    date:new Date().toLocaleString(),
    class:$("quizClass").value,
    subject:subjectNames[$("quizSubject").value],
    score:correctCount,total,percent
  };
  const scores = load("jvsHelpScores",[]);
  scores.unshift(record);
  save("jvsHelpScores",scores.slice(0,30));
  $("quizArea").innerHTML = `
    <div style="text-align:center;padding:15px 0">
      <div style="font-size:55px">${percent>=60?"🏆":"📘"}</div>
      <h2>Test Completed!</h2>
      <p class="sub">Class ${record.class} • ${escapeHTML(record.subject)}</p>
      <h2 style="color:var(--primary);font-size:38px">${correctCount}/${total}</h2>
      <p>तुम्हारा स्कोर: <strong>${percent}%</strong></p>
      <div class="feedback">${percent>=60?"बहुत अच्छा! अभ्यास जारी रखो।":"अच्छी कोशिश! फिर से अभ्यास करो।"}</div>
      <button class="btn btn-primary" id="retryQuiz" style="margin-top:15px">Try Again ↻</button>
    </div>
  `;
  $("retryQuiz").addEventListener("click",startQuiz);
  renderScores();
}

function renderScores(){
  const scores = load("jvsHelpScores",[]);
  $("scoreList").innerHTML = scores.length ? scores.map(s=>`
    <div class="note-item">
      <h3>Class ${escapeHTML(s.class)} · ${escapeHTML(s.subject)}</h3>
      <p class="sub">${escapeHTML(s.date)}</p>
      <strong style="color:var(--primary)">${s.score}/${s.total} (${s.percent}%)</strong>
    </div>
  `).join("") : '<div class="empty">अभी कोई टेस्ट रिजल्ट नहीं है। पहले MCQ Quiz दो!</div>';
}
$("clearScores").addEventListener("click",()=>{
  if(confirm("क्या तुम टेस्ट हिस्ट्री हटाना चाहते हो?")){
    save("jvsHelpScores",[]);
    renderScores();
  }
});

// Notes that come with the starter website are sample resources.
const defaultNotes = [
  {id:"n1",class:"9",subject:"Mathematics",title:"गणित: अभ्यास और सूत्र",url:""},
  {id:"n2",class:"9",subject:"Science",title:"विज्ञान: अध्यायवार तैयारी",url:""},
  {id:"n3",class:"9",subject:"GK",title:"सामान्य ज्ञान अभ्यास",url:""},
  {id:"n4",class:"10",subject:"Science",title:"विज्ञान: परीक्षा तैयारी",url:""},
  {id:"n5",class:"8",subject:"Mathematics",title:"गणित: बुनियादी अभ्यास",url:""},
  {id:"n6",class:"6",subject:"English",title:"English: Basic Practice",url:""}
];

function allNotes(){
  return [...defaultNotes,...load("jvsHelpNotes",[])];
}
function renderNotes(){
  const cls = $("noteClass").value;
  const q = $("noteSearch").value.toLowerCase().trim();
  const list = allNotes().filter(n=>
    (cls==="all"||n.class===cls) &&
    (n.title+" "+n.subject+" "+n.class).toLowerCase().includes(q)
  );
  $("notesList").innerHTML = list.length ? list.map(n=>`
    <div class="note-item">
      <span class="tag">CLASS ${escapeHTML(n.class)}</span>
      <span class="tag">${escapeHTML(n.subject)}</span>
      <h3>${escapeHTML(n.title)}</h3>
      <p class="sub">${n.url?"PDF link उपलब्ध है।":"अभी PDF लिंक नहीं जोड़ा गया है।"}</p>
      ${n.url ? `<a class="btn btn-light" href="${escapeHTML(n.url)}"
        target="_blank" rel="noopener noreferrer">Open PDF ↗</a>` :
        '<span class="small">स्टडी मटेरियल का लिंक शिक्षक द्वारा जोड़ा जाना बाकी है।</span>'}
    </div>
  `).join("") : '<div class="empty">कोई नोट्स नहीं मिले।</div>';
}
$("noteClass").addEventListener("change",renderNotes);
$("noteSearch").addEventListener("input",renderNotes);

$("noteForm").addEventListener("submit",e=>{
  e.preventDefault();
  const url = $("addUrl").value.trim();
  try{
    const parsed = new URL(url);
    if(parsed.protocol!=="https:" && parsed.protocol!=="http:"){
      alert("कृपया सही PDF URL डालो।");return;
    }
  }catch(err){alert("कृपया सही PDF URL डालो।");return;}
  const notes = load("jvsHelpNotes",[]);
  notes.unshift({
    id:"custom-"+Date.now(),
    class:$("addClass").value,
    subject:$("addSubject").value.trim(),
    title:$("addTitle").value.trim(),
    url
  });
  if(save("jvsHelpNotes",notes)){
    e.target.reset();
    $("addClass").value="9";
    renderNotes();
    alert("नोट्स इस ब्राउज़र में सेव हो गए!");
  }
});

