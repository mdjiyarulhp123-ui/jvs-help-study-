
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101c40">
<meta name="description" content="JVS Help Study - Class 6 to 10, free notes, MCQ quizzes and study resources.">
<title>JVS Help Study | Learn Every Day</title>

<style>
:root{
  --bg:#f4f7ff;
  --card:#ffffff;
  --text:#182447;
  --muted:#687592;
  --primary:#5146e5;
  --blue:#1478f2;
  --border:#e3e9f5;
  --green:#0d9b71;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
}
button,input,select{font:inherit}
button,a{touch-action:manipulation}
a{color:inherit;text-decoration:none}
button{cursor:pointer}
header{
  background:#101c40;color:white;position:sticky;top:0;
  z-index:20;box-shadow:0 3px 18px #101c4020;
}
.nav{
  max-width:1120px;margin:auto;padding:13px 18px;
  display:flex;align-items:center;justify-content:space-between;gap:12px;
}
.brand{display:flex;align-items:center;gap:10px;font-weight:850;font-size:19px}
.logo{
  width:43px;height:43px;border-radius:14px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,#776bff,#20b9ee);
  font-weight:900;font-size:19px;
}
nav{display:flex;gap:15px;align-items:center}
nav a{font-size:13px;color:#e1e8ff}
nav a:hover{color:#65d5ff}
.menu{display:none;background:#26365d;color:white;border:0;
  padding:9px 12px;border-radius:10px}
.hero{
  background:linear-gradient(130deg,#111d43,#243d8c 60%,#5146e5);
  color:white;padding:52px 20px 62px;overflow:hidden;
}
.hero-inner{max-width:1080px;margin:auto;display:grid;
  grid-template-columns:1.3fr .7fr;gap:25px;align-items:center}
.pill{display:inline-block;background:#ffffff1c;border:1px solid #ffffff30;
  padding:7px 12px;border-radius:30px;font-size:12px}
.hero h1{font-size:clamp(34px,6vw,57px);line-height:1.12;margin:18px 0}
.hero h1 span{color:#7be4ff}
.hero p{color:#dce6ff;line-height:1.8;max-width:570px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}
.btn{border:0;border-radius:12px;padding:12px 17px;font-weight:750;
  display:inline-flex;align-items:center;justify-content:center;gap:7px}
.btn-main{background:#fff;color:#2639a3}
.btn-ghost{background:#ffffff16;color:white;border:1px solid #ffffff50}
.btn-primary{background:var(--primary);color:white}
.btn-green{background:var(--green);color:white}
.btn-light{background:#edf0ff;color:#4339bd}
.hero-art{
  min-height:235px;border:1px solid #ffffff35;border-radius:30px;
  background:linear-gradient(145deg,#ffffff20,#ffffff08);
  display:grid;place-items:center;text-align:center;padding:25px;
  box-shadow:0 25px 70px #090f2e30;
}
.book{font-size:78px;filter:drop-shadow(0 10px 12px #0003)}
.hero-art h3{margin:10px 0 5px;font-size:22px}
.hero-art p{margin:0;font-size:13px}
.stats{
  max-width:1000px;margin:-28px auto 0;padding:0 16px;
  display:grid;grid-template-columns:repeat(3,1fr);gap:12px;position:relative;
}
.stat{background:var(--card);padding:19px 10px;border-radius:18px;
  text-align:center;border:1px solid var(--border);box-shadow:0 7px 24px #243d8c09}
.stat strong{display:block;color:var(--primary);font-size:23px}
.stat span{font-size:12px;color:var(--muted)}
main{max-width:1080px;margin:auto;padding:30px 17px 60px}
section{scroll-margin-top:85px;margin-top:37px}
.section-head{display:flex;align-items:end;justify-content:space-between;
  gap:12px;margin-bottom:17px}
h2{font-size:25px;margin:0 0 6px}
.sub{color:var(--muted);font-size:13px;line-height:1.7;margin:0}
.searchbar{
  width:100%;padding:13px 15px;border:1px solid var(--border);
  border-radius:13px;background:var(--card);outline:none;color:var(--text);
  margin:10px 0 18px;
}
.searchbar:focus,input:focus,select:focus{border-color:var(--primary)}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.card{
  background:var(--card);border:1px solid var(--border);border-radius:19px;
  padding:19px;box-shadow:0 5px 20px #253c7810;
}
.class-card{transition:transform .2s,border-color .2s}
.class-card:hover{transform:translateY(-3px);border-color:#b9b5ff}
.class-icon{font-size:29px;margin-bottom:12px}
.card h3{font-size:17px;margin:0 0 7px}
.card p{font-size:13px;line-height:1.7;color:var(--muted)}
.tag{display:inline-block;background:#efefff;color:#5146c9;
  border-radius:8px;padding:5px 8px;font-size:11px;margin:2px 3px 9px 0}
.card .btn{width:100%;margin-top:8px}
.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.tools select,.tools input{
  min-width:0;padding:11px;border:1px solid var(--border);
  background:var(--card);border-radius:10px;color:var(--text);
}
.tools select{flex:1}
.tools input{flex:2}
.quiz-question{font-size:17px;font-weight:750;line-height:1.6;margin:17px 0}
.option{
  display:flex;gap:10px;align-items:center;padding:12px;margin:9px 0;
  border:1px solid var(--border);border-radius:12px;cursor:pointer;
}
.option:has(input:checked){border-color:var(--primary);background:#f2f1ff}
.option input{accent-color:var(--primary)}
.feedback{padding:12px;border-radius:12px;background:#eef3ff;
  line-height:1.7;margin-top:14px;font-size:14px}
.note-item{border-bottom:1px solid var(--border);padding:14px 0}
.note-item:last-child{border-bottom:0}
.note-item h3{margin-bottom:5px}
.empty{padding:24px;text-align:center;color:var(--muted);font-size:14px}
footer{background:#101c40;color:white;text-align:center;padding:30px 16px}
footer p{color:#c8d2ed;font-size:13px;line-height:1.8}
footer a{color:#7be4ff}
.small{font-size:12px;color:var(--muted)}
hr{border:0;border-top:1px solid var(--border);margin:15px 0}
.hidden{display:none!important}
body.dark{
  --bg:#0b1226;--card:#141e36;--text:#eef2ff;
  --muted:#a7b4d0;--border:#293651;
}
body.dark .tag{background:#282b54;color:#c4c2ff}
body.dark .option:has(input:checked){background:#242344}
body.dark .feedback{background:#1d2d4c}
body.dark .searchbar,body.dark .tools select,body.dark .tools input{color:var(--text)}
@media(max-width:700px){
  nav{display:none;position:absolute;top:68px;left:12px;right:12px;
    background:#101c40;padding:17px;border-radius:14px;
    flex-direction:column;align-items:stretch;box-shadow:0 12px 30px #0003}
  nav.open{display:flex}
  nav a{padding:7px}
  .menu{display:block}
  .hero{padding:38px 18px 48px}
  .hero-inner{grid-template-columns:1fr}
  .hero-art{min-height:170px}
  .book{font-size:55px}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .card{padding:14px}
  .card h3{font-size:15px}
  .card p{font-size:12px}
  .section-head{align-items:start;flex-direction:column}
  h2{font-size:22px}
}
@media(max-width:390px){
  .grid{grid-template-columns:1fr}
  .stats{gap:7px}
  .stat{padding:15px 5px}
  .stat strong{font-size:19px}
  .brand{font-size:16px}
}
</style>
</head>

<body>
<header>
  <div class="nav">
    <a href="#home" class="brand">
      <div class="logo">JVS</div>
      <span>JVS Help Study</span>
    </a>
    <nav id="nav">
      <a href="#home">Home</a>
