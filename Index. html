</div>

<div class="stats">
  <div class="stat"><strong>6–10</strong><span>Classes</span></div>
  <div class="stat"><strong>Free</strong><span>Learning Resources</span></div>
  <div class="stat"><strong>24/7</strong><span>Learn at Your Pace</span></div>
</div>

<main>
  <section id="classes">
    <div class="section-head">
      <div>
        <h2>📚 Choose Your Class</h2>
        <p class="sub">अपनी कक्षा चुनकर पढ़ाई शुरू करो।</p>
      </div>
    </div>
    <input id="classSearch" class="searchbar"
      placeholder="🔎 कक्षा खोजें... जैसे Class 9" aria-label="Search classes">
    <div class="grid" id="classGrid"></div>
  </section>

  <section id="quiz">
    <div class="section-head">
      <div>
        <h2>✍️ MCQ Practice Quiz</h2>
        <p class="sub">सवाल हल करो और तुरंत अपना स्कोर जानो।</p>
      </div>
    </div>
    <div class="card">
      <div class="tools">
        <select id="quizClass" aria-label="Choose quiz class">
          <option value="6">Class 6</option>
          <option value="7">Class 7</option>
          <option value="8">Class 8</option>
